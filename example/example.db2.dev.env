# Example Db2 connection profile
# 복사 후 수정하여 사용: cp example.db2.dev.env {project}.db2.{env}.env
#
# Db2 는 usql 이 아니라 db_schema.py 를 통해 접속합니다 (README: "usql + ODBC 의 한계").
# 먼저: pip install ibm_db

DB_ALIAS=example_db2_dev
DB_TYPE=db2
DB_HOST=localhost
DB_PORT=50000
DB_USER=db2inst1
DB_PASS=changeme
DB_NAME=SAMPLE
